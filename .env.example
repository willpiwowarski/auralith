# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string. Neon, Supabase, or any Postgres works.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# AWS S3 — where original uploads and parsed projections are stored.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY can be omitted if you've
# configured credentials via the AWS CLI or an instance role.
AWS_REGION="us-east-2"
AWS_S3_BUCKET="your-bucket-name"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Google Gemini API key for the chat and chart-generation endpoints.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
